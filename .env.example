# --- Supabase (create a free project at https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # browser realtime read — safe to expose to the client
SUPABASE_SERVICE_ROLE_KEY=            # server only (mcp + /api) — NEVER expose to the browser

# --- MCP identity ---
MYCELIUM_OWNER_ID=local               # any stable string per install; scopes your private skills

# --- Embeddings ---
# Mycelium embeds locally with Supabase/gte-small (@xenova/transformers) — no API key needed.
# OPENAI_API_KEY is only needed if you switch shared/src/embed.ts back to the OpenAI path.
# OPENAI_API_KEY=
