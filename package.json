{
  "name": "mycelium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "npm for agent knowledge — an MCP server that auto-generates, shares, and trust-scores reusable skills for AI agents.",
  "license": "MIT",
  "workspaces": [
    "shared",
    "mcp",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspace @mycelium/shared",
    "seed": "tsx supabase/seed.ts",
    "mcp": "tsx mcp/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
